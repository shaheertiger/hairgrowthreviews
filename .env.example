# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Used only by `npm run amazon:search` and `npm run amazon:sync`. The build reads
# the committed data/amazon/products.json and never needs these.

# From the Amazon Associates Creators API console.
AMAZON_CREATORS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_CREATORS_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx

# Associates tracking ID. Public — it is in every outbound link.
AMAZON_CREATORS_PARTNER_TAG=sktiger-20

# Optional overrides
# AMAZON_CREATORS_VERSION=3.1
# AMAZON_CREATORS_MARKETPLACE=www.amazon.com
